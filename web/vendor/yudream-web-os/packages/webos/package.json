{
  "name": "@yudream/yudream-webos",
  "type": "module",
  "version": "0.2.0",
  "description": "YudreamWebOS: standalone WebOS UI library for Vue 3 - theme, windows, desktop, grid tiles, cards, dock, quick launch, launchpad, sandboxed browser",
  "author": "YuDream",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
